@Metadata.layer: #CORE
@UI: { 
    headerInfo: { 
        typeName: 'Equipe',
        typeNamePlural: 'Equipes'      
    }
}
annotate view ZC_EQUIPE_OR with
{ 
  @UI.facet: [ {
    label: 'Dados da Equipe', 
