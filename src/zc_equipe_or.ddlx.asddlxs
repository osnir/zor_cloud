    position: 40 , 
    label: 'Cidade'
  } ]
  @UI.lineItem: [ {
    position: 40 , 
    label: 'Cidade'
  } ]
  @UI.selectionField: [ {
    position: 40 
  } ]
  Cidade;
  
  @EndUserText.label: 'QtdTitulos'
  @UI.identification: [ {
    position: 50 , 
    label: 'Qtd.Títulos'
  } ]
  @UI.lineItem: [ {
    position: 50 , 
    label: 'Qtd.Títulos'
  } ]
  @UI.selectionField: [ {
    position: 50 
  } ]
